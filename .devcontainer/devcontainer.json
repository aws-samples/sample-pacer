{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "PACER (default features)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  // target/ MUST NOT be the host's. The repo's own Makefile warns about it: two
  // toolchains writing one target/ directory fails with E0514 ("found crate
  // compiled by a different version of rustc"), and the host tree is macOS
  // artifacts while this container produces Linux ones. A named volume outside
  // the workspace keeps them apart AND makes rebuilds incremental across
  // container restarts. The registry volume saves re-downloading the index.
  "containerEnv": {
    "CARGO_TARGET_DIR": "/build/target"
  },
  "mounts": [
    "source=pacer-devcontainer-target,target=/build/target,type=volume",
    "source=pacer-devcontainer-registry,target=/usr/local/cargo/registry,type=volume"
  ],

  // Everything CI gates on, minus the EFA feature. Run it before opening a PR.
  "postAttachCommand": "cargo --version && echo 'PACER devcontainer ready — try: make ci'",

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        // rust-analyzer must use the same volume-backed target dir as the shell,
        // or it and `cargo` invalidate each other's fingerprints on every save.
        "rust-analyzer.cargo.targetDir": "/build/target",
        "rust-analyzer.check.command": "clippy"
      }
    }
  }
}
