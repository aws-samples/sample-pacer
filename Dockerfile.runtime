# Runtime-only image assembled by CI (multi-arch): the binary is built natively
# per arch in the build-binary job and COPY'd in, so kaniko never has to RUN
# anything under emulation. Keep ENV/ENTRYPOINT in sync with ./Dockerfile
# (the self-contained local build) and ci/Dockerfile.release (the GitHub
# release workflow's single-graph build).
#
# EFA (Phase 3 A2, planning/11 item #4): the daemon is built `--features efa` and
# dynamically links libefa/libibverbs, and libibverbs dlopen's the EFA provider
# plugin at device enumeration. build-binary staged that whole runtime closure
# (linked libs + provider plugin + /etc/libibverbs.d) into bin/$ARCH/efa-rootfs
# via ci/stage-efa-libs.sh; we lay it over the AL2023-minimal base preserving
# absolute paths, so glibc's default loader path resolves it — no extra
# installer run, image stays COPY-only (no RUN, so kaniko never emulates). The
# staging script's asserts are the drift tripwire.
#
# AL2023-minimal, not gcr.io/distroless: no ECR Public mirror of distroless
# exists (confirmed), and the builder is now AL2023 too (ci/Dockerfile.efa-
# builder) — build and runtime must share one glibc family or the binary's
# dynamic symbol versions won't resolve at load time.
#
# Pinned to an IMMUTABLE dated release, not the floating `:2023-minimal` tag,
# which AL updates in place (unreproducible builds). BUMP THIS IN LOCKSTEP with
# the builder pin in ci/Dockerfile.efa-builder: the whole point is that the
# glibc the binary is linked against is the glibc it runs on (both currently
# glibc 2.34-231, verified identical).
FROM public.ecr.aws/amazonlinux/amazonlinux:2023.12.20260831.0-minimal
# checkov:skip=CKV_DOCKER_2:Health is checked by Kubernetes, not by Docker — the
# chart's livenessProbe/readinessProbe hit /healthz and /readyz, and kubelet
# ignores HEALTHCHECK. Adding one would require a shell and an HTTP client in an
# -minimal image that deliberately has neither.
# UID/GID 65532 is a hard contract with deploy/helm/pacer (the DaemonSet's init
# chown) and the bench Job manifests (runAsUser: 65532) — it must match exactly
# what the old gcr.io/distroless/*:nonroot tag baked in. AL2023-minimal has no
# useradd/shadow-utils, so add the passwd/group entries directly, the same way
# distroless itself fakes a "nonroot" user.
RUN echo 'pacer:x:65532:65532:pacer:/nonexistent:/sbin/nologin' >> /etc/passwd \
 && echo 'pacer:x:65532:' >> /etc/group
ARG ARCH=amd64
COPY bin/$ARCH/efa-rootfs/ /
COPY bin/$ARCH/pacer-daemon /usr/local/bin/pacer-daemon
# Cache dir is a hostPath mount in-cluster; this default serves local runs.
ENV PACER_CACHE_DIR=/tmp/pacer-cache
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/pacer-daemon"]
